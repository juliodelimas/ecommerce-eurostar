{
  "name": "ecommerce-eurostar",
  "version": "1.0.0",
  "description": "REST API for e-commerce with JWT authentication and checkout",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "start-server-and-test start http://localhost:3000/healthcheck \"mocha 'test/pathCoverage/**/*.test.js' --timeout 10000 --reporter mochawesome --reporter-options reportDir=mochawesome-report,reportFilename=index,html=true,json=true\""
  },
  "keywords": ["ecommerce", "express", "rest-api"],
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "mocha": "^11.1.0",
    "mochawesome": "^7.1.3",
    "start-server-and-test": "^2.0.11",
    "supertest": "^7.1.0"
  }
}
